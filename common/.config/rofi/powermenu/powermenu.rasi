@import "~/.config/rofi/colors.rasi"
@import "~/.config/rofi/appmenu/fonts.rasi"

* {
    background-color: @base;
    text-color: @text;
}

window {
    transparency:       "real";
    location:           center;
    anchor:             center;
    fullscreen:         false;
    /* Fenêtre plus petite pour un menu Power */
    width:              280px; 
    height:             235px;

    enabled:            true;
    margin:             0px;
    padding:            0px;
    border:             2px solid;
    border-radius:      15px;
    border-color:       @accent;
    cursor:             "default";
}

mainbox {
    enabled:            true;
    spacing:            10px;
    margin:             0px;
    padding:            20px;
    background-color:   transparent;
    /* On a enlevé "inputbar" ici pour supprimer la recherche */
    children:           [ "listview" ]; 
}

/* L'inputbar est conservée dans le code mais désactivée par le children de mainbox */

listview {
    enabled:            true;
    columns:            1;
    lines:              4; /* Ajusté pour Shutdown/Reboot/Sleep/Logout */
    cycle:              true;
    dynamic:            true;
    scrollbar:          false;
    layout:             vertical;
    reverse:            false;
    fixed-height:       true;
    fixed-columns:      true;
    
    spacing:            5px;
    margin:             0px;
    padding:            0px;
    background-color:   transparent;
    text-color:         @text;
    cursor:             "default";
}

element {
    enabled:            true;
    spacing:            10px;
    margin:             0px;
    padding:            12px; /* Un peu plus de padding pour le confort tactile/visuel */
    border-radius:      8px;
    background-color:   transparent;
    text-color:         @text;
    cursor:             pointer;
}

element selected.normal {
    background-color:   @accent; /* On utilise l'accent pour la sélection */
    text-color:         @base;   /* Texte contrasté sur l'accent */
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    cursor:             inherit;
    vertical-align:     0.5;
    horizontal-align:   0.5; /* Centré horizontalement */
}

element-icon {
    enabled:            false; /* Désactivé car on utilise souvent des Nerd Fonts en texte */
}
