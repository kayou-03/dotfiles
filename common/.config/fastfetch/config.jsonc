{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty", // (ou "sixel", "chafa" selon ton choix précédent)
    "width": 35,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "modules": [
    "title",          // Affiche noah@ton-pc
    "separator",      // Une petite ligne esthétique (-----------)
    
    // --- Système ---
    "os",             // Affiche Arch Linux
    "kernel",         // La version du noyau
    "uptime",         // Depuis combien de temps le PC est allumé
    "packages",       // Le nombre de paquets installés (pacman)
    
    // --- Environnement ---
    "shell",          // zsh ou bash
    "wm",             // Ton Window Manager (Hyprland !)
    "wmtheme",        // Le thème utilisé
    "terminal",       // Ton émulateur de terminal
    
    "separator",
    
    // --- Matériel ---
    "cpu",
    "gpu",
    "memory",         // La RAM utilisée
    "disk",           // Affiche l'espace de tes SSD
    "battery",
    
    "break",          // Saute une ligne
    "colors"          // Affiche la palette de couleurs de ton terminal
  ]
}
